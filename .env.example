# ─────────────────────────────────────────────────────────────────────────────
# Backstage File-Upload Plugin – Environment Variables
#
# Copy this file to .env and fill in the values before running the app.
# The file is read automatically by the Backstage config loader when you
# export / source it or use `dotenv` style tooling.
# ─────────────────────────────────────────────────────────────────────────────

# GitHub Personal Access Token (PAT)
# Required scopes: repo (to push files to the repository)
GITHUB_TOKEN=ghp_REPLACE_ME

# GitHub owner (your username or organisation name)
GITHUB_OWNER=your-github-username

# GitHub repository name (must already exist)
GITHUB_REPO=your-repo-name

# Branch to push uploaded files to (default: main)
GITHUB_BRANCH=main
