# ─────────────────────────────────────────────────────────────────────────────
# Backstage File-Upload Plugin – Environment Variables
#
# Copy this file to .env and fill in the values before running the app.
# `yarn start` loads this file automatically (via dotenv-cli), so you no
# longer need to `export` the variables manually in every shell session.
# Variables already exported in your shell take precedence over this file.
# ─────────────────────────────────────────────────────────────────────────────

# GitHub App credentials.
# Encode the downloaded private key with:
#   base64 -w0 app.private-key.pem
BACKSTAGE_GH_APP_ID=123456
BACKSTAGE_GH_APP_CLIENT_ID=Iv1.REPLACE_ME
BACKSTAGE_GH_APP_CLIENT_SECRET=REPLACE_ME
# Local `yarn start`: PEM with literal \n separators.
BACKSTAGE_GH_APP_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----
# Deployment secret: base64 -w0 app.private-key.pem
BACKSTAGE_GH_APP_PRIVATE_KEY_B64=BASE64_PRIVATE_KEY_REPLACE_ME

# GitHub owner (organisation where the App is installed)
GITHUB_OWNER=willsreistech

# GitHub repository name (must already exist)
GITHUB_REPO=your-repo-name

# Allowlist separada por vírgulas dos repositórios que podem receber artefatos.
GITHUB_ALLOWED_REPOS=repo-one,repo-two

# Branch to push uploaded files to (default: main)
GITHUB_BRANCH=main

# ── (Opcional) Workaround de TLS para runner atrás de FortiGate ──────────────
# Só é necessário em ambientes com SSL-inspection (ex.: o runner self-hosted
# atual, atrás de FortiGate). Diagnóstico do ambiente atual:
#
#   • O FortiGate NÃO consegue inspecionar TLS 1.3: quando o Node negocia 1.3
#     ele INTERCEPTA a conexão e devolve o certificado default da Fortinet
#     (CN=FortiClient, emissor "support", SEM SAN) -> o backend falha ao ler
#     catálogos/integrations por HTTPS (ex.: o k9 em willsreis/k9) com
#     "unable to verify the first certificate".
#   • Em TLS 1.2 o FortiGate DEIXA PASSAR a conexão real (curl/openssl, que
#     usam 1.2, sempre funcionaram). Por isso o Node também precisa cair p/ 1.2.
#
# FIX PRINCIPAL: forçar o Node a no máximo TLS 1.2 (vale p/ todo o backend:
# catalog reader, octokit, techdocs, etc.). Descomente:
# NODE_OPTIONS=--tls-max-v1.2
#
# FIX COMPLEMENTAR (CA store): garante que o Node confie na cadeia. Aponta p/ o
# bundle do sistema. Se algum host entregar a cadeia INCOMPLETA (sem o
# intermediário), rode uma vez `sudo ./scripts/fix-fortigate-ca.sh` p/ instalar
# os intermediários faltantes (baixados via AIA). Descomente:
# NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt
#
# NOTA: na NOVA arquitetura (sem FortiGate / sem SSL-inspection) AMBAS as linhas
# são desnecessárias — deixe comentadas. Só descomente em runners inspecionados.
